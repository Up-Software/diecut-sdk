{
  "name": "@up-software/diecut-sdk",
  "version": "0.2.0",
  "description": "Unofficial Node.js/TypeScript SDK for the diecuttemplates.com APIs: Dielines API and Dieline Dimensions API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Up-Software/diecut-sdk.git"
  },
  "homepage": "https://github.com/Up-Software/diecut-sdk#readme",
  "bugs": {
    "url": "https://github.com/Up-Software/diecut-sdk/issues"
  },
  "engines": {
    "node": ">=18.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:runtime": "node scripts/runtime-smoke.cjs",
    "lint": "oxlint --type-aware",
    "lint:package": "publint --strict && attw --pack ."
  },
  "keywords": [
    "diecuttemplates",
    "dielines",
    "dieline-dimensions-api",
    "packaging",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "3.10.1",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
